# Local development only. On Vercel, set these in Project Settings > Environment Variables.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/link-shortener
# Optional. Public address used to build short links.
# Locally: http://localhost:5000
# On Vercel: leave it unset and the domain is detected automatically.
BASE_URL=http://localhost:5000
