{
  "name": "link-shortener",
  "version": "1.0.0",
  "private": true,
  "main": "server/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0"
  }
}
